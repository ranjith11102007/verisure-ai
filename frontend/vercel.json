{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://verisure-backend-m1rb.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://verisure-backend-m1rb.onrender.com/uploads/:path*"
    },
    {
      "source": "/((?!assets/|favicon.svg|icons.svg).*)",
      "destination": "/index.html"
    }
  ]
}
