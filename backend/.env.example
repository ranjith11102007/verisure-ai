# VeriSure AI - Environment Configuration
# Copy this to .env and update values

# Application
APP_NAME=VeriSure AI
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-secure-random-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://verisure_user:verisure_pass@localhost:5432/verisure_db

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# OCR
TESSERACT_CMD=

# Admin Bootstrap (set on first run)
ADMIN_EMAIL=admin@verisure.local
ADMIN_PASSWORD=change-this-password
ADMIN_FULL_NAME=System Administrator

# Email (optional - leave empty for local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@verisure.local
